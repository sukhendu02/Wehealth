# =========================================================
# Project root .gitignore
# Layout: project/ -> client/ (React + Vite)  server/ (Node + Express)
# One file at the root covers both folders.
# =========================================================

# ---------- Dependencies ----------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ---------- Environment files / SECRETS (never commit) ----------
.env
.env.*
**/.env
**/.env.*
# ...but DO commit the example files (names only, no real values)
!.env.example
!**/.env.example

# ---------- Build output ----------
client/dist/
client/build/
server/dist/
server/build/
dist/
build/
.vite/
**/.vite/
*.tsbuildinfo

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Runtime / cache ----------
pids/
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.node_repl_history
*.tgz

# ---------- Test / coverage ----------
coverage/
.nyc_output/

# ---------- Uploads (user-generated files; keep the folder, not the files) ----------
server/uploads/*
!server/uploads/.gitkeep
server/public/uploads/*
!server/public/uploads/.gitkeep

# ---------- Local databases / dumps ----------
*.sqlite
*.sqlite3
*.db
*.rdb
dump/

# ---------- Keys and certificates ----------
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------- OS files ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Editors / IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Claude Code ----------
# Personal local settings stay private; the shared .claude/settings.json IS committed
.claude/settings.local.json
CLAUDE.local.md

# ---------- Temporary / backup files ----------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.bundle

# =========================================================
# IMPORTANT: do NOT ignore these. They must be committed.
#   package.json
#   package-lock.json   (both client/ and server/)
#   .env.example
#   .github/            (workflows, CODEOWNERS, PR template)
#   .claude/settings.json
#   CLAUDE.md
# =========================================================