{
  "description": "Deny rules for destructive git commands as per R079 / R041 / R065",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D*)",
      "Bash(git push --delete*)",
      "Bash(git push origin --delete*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git commit --amend*)"
    ]
  }
}
