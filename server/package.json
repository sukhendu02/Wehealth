{
  "name": "server",
  "version": "1.0.0",
  "description": "admin panel for nurishbox",
  "license": "ISC",
  "author": "Sukhendu",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "sequelize-cli db:migrate --config config/db/config.js --migrations-path config/db/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/db/config.js --migrations-path config/db/migrations",
    "db:migrate:status": "sequelize-cli db:migrate:status --config config/db/config.js --migrations-path config/db/migrations",
    "db:new": "node scripts/new-migration.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}